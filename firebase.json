{
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "RadQuiz",
        "supportEmail": "pavelucho666@gmail.com",
        "authorizedRedirectUris": []
      }
    }
  },
  "hosting": {
    "public": "_site",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
