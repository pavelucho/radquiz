#!/usr/bin/env python3
"""Trae a temas/ los cuestionarios publicados en el estudio web y sus sellos de verificación.

Uso:
    tools/traer_publicaciones          escribe los temas nuevos o actualizados
    tools/traer_publicaciones --ver    solo dice qué cambiaría

Lee dos nodos públicos de la base del estudio:
- «publicacion»: el contenido que el autor publicó (todos sus casos, sin sello).
- «verificacion»: qué caso marcó cada radiólogo y cuándo. Un sello vale solo si el autor no
  tocó el caso después; si lo cambió, el caso vuelve a quedar sin verificar.

Los temas que el estudio dejó de publicar se quitan de temas/ (solo los que trajo este comando:
llevan la marca .origen-estudio).

Las figuras no se copian: están en el Google Drive de quien publicó y la ficha de cada imagen lleva el
id del archivo («drive»). Solo los temas publicados antes de eso las traen en base64 desde
«publicacion_img», y esas sí se guardan en img/.

Cada tema pasa por tools/validar antes de entrar: uno que no pasa se queda fuera del archivo, con su
versión anterior si la había, y los demás siguen.
"""

import argparse
import base64
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import sys
import tempfile
import urllib.request
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent


def cargar_validador():
    """tools/validar como módulo, para validar cada tema antes de guardarlo."""
    cargador = importlib.machinery.SourceFileLoader("validar", str(RAIZ / "tools" / "validar"))
    modulo = importlib.util.module_from_spec(importlib.util.spec_from_loader("validar", cargador))
    cargador.exec_module(modulo)
    return modulo


VALIDAR = cargar_validador()
ESQUEMAS = VALIDAR.Esquemas(VALIDAR.CARPETA_ESQUEMAS)
BASE = os.environ.get("RADQUIZ_DB", "https://radquiz-shpn2-default-rtdb.firebaseio.com")
SEGMENTOS = json.loads((RAIZ / "schema" / "paquete.schema.json").read_text(encoding="utf-8"))["$defs"]["segmento"]["enum"]
NOMBRE = re.compile(r"^[a-z0-9]+([-_][a-z0-9]+)*\.jpg$")
ID = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
DRIVE = re.compile(r"^[A-Za-z0-9_-]{20,100}$")
USUARIO = re.compile(r"^[a-z0-9._-]+$")
MARCA = ".origen-estudio"


def traer(ruta):
    with urllib.request.urlopen(f"{BASE}/{ruta}", timeout=60) as r:
        return json.loads(r.read().decode("utf-8"))


def fecha(ms):
    import datetime
    return datetime.datetime.fromtimestamp(ms / 1000, datetime.timezone.utc).date().isoformat()


def sellar(paquete, actualizados, verificacion):
    """Pone revisor y fecha en los casos verificados cuyo contenido no cambió después."""
    personas = dict(paquete.get("personas") or {})
    sellados = 0
    for caso in paquete["casos"]:
        v = (verificacion or {}).get(caso["id"])
        caso["revisor"] = None
        caso.pop("fecha_revision", None)
        if not v or v.get("decision") != "verificado":
            continue
        usuario = v.get("usuario", "")
        base = v.get("base", 0)
        if not USUARIO.match(usuario):
            continue
        if (actualizados or {}).get(caso["id"], 0) > base:
            continue  # el autor lo cambió después de verificarlo
        caso["revisor"] = usuario
        caso["fecha_revision"] = fecha(v.get("fecha", 0))
        personas.setdefault(usuario, v.get("nombre", usuario))
        sellados += 1
    if personas:
        paquete["personas"] = personas
    return sellados


def escribir_tema(clave, publicacion, verificacion, solo_ver):
    paquete = json.loads(publicacion["paquete_json"])
    fuentes = json.loads(publicacion["fuentes_json"])
    version = publicacion.get("version", paquete.get("version"))
    tema_id, segmento = paquete.get("id", ""), paquete.get("segmento", "")
    if not ID.match(tema_id) or tema_id != clave or segmento not in SEGMENTOS:
        print("  ⚠ %s: id o segmento inválidos; lo salto" % clave)
        return False

    paquete["version"] = version
    sellados = sellar(paquete, publicacion.get("actualizados"), verificacion)
    carpeta = RAIZ / "temas" / segmento / tema_id
    nuevo = json.dumps(paquete, ensure_ascii=False, indent=2) + "\n"
    actual = carpeta / "paquete.json"
    if actual.is_file() and actual.read_text(encoding="utf-8") == nuevo:
        return False
    if solo_ver:
        print("  · %s/%s cambiaría (%d casos, %d verificados)" % (segmento, tema_id, len(paquete["casos"]), sellados))
        return True

    fichas = paquete.get("imagenes", {})
    en_drive = {img_id for img_id, ficha in fichas.items() if ficha.get("drive")}
    imagenes = (traer(f"publicacion_img/{clave}.json") or {}) if len(en_drive) < len(fichas) else {}
    # Todo se comprueba antes de tocar el disco: un tema con una imagen mala no deja nada a medias.
    for img_id, ficha in fichas.items():
        valida = (DRIVE.match(str(ficha.get("drive"))) if img_id in en_drive
                  else str(imagenes.get(img_id, "")).startswith("data:image/jpeg;base64,"))
        if not NOMBRE.match(ficha.get("archivo", "")) or not valida:
            print("  ⚠ %s: imagen %s inválida; salto el tema" % (clave, img_id))
            return False
    # Se arma aparte y se valida: un tema que no pasa no entra al archivo (y el que ya estaba se queda como
    # estaba), sin frenar a los demás ni el despliegue.
    with tempfile.TemporaryDirectory() as tmp:
        borrador = Path(tmp) / "temas" / segmento / tema_id
        (borrador / "img").mkdir(parents=True)
        aqui = 0
        for img_id, ficha in fichas.items():
            if img_id in en_drive:
                continue  # vive en el Drive de quien publicó: el repositorio no guarda copia
            (borrador / "img" / ficha["archivo"]).write_bytes(base64.b64decode(imagenes[img_id].split(",", 1)[1]))
            aqui += 1
        if not aqui:
            (borrador / "img").rmdir()
        (borrador / "paquete.json").write_text(nuevo, encoding="utf-8")
        (borrador / "fuentes.json").write_text(json.dumps(fuentes, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        (borrador / MARCA).write_text("Este tema lo mantiene el estudio web; no lo edites a mano.\n", encoding="utf-8")
        reporte, _ = VALIDAR.validar_paquete(borrador, ESQUEMAS, set())
        if reporte.errores:
            print("  ⚠ %s: no pasa el validador; queda fuera del archivo hasta que se corrija" % clave)
            for gravedad, donde, mensaje in reporte.lineas:
                if gravedad == "ERROR":
                    print("      %s: %s" % (donde, mensaje))
            if os.environ.get("GITHUB_ACTIONS") == "true":
                print("::warning::%s no pasa el validador (%d errores) y no se archiva: corrígelo en el estudio y "
                      "vuelve a publicarlo." % (clave, reporte.errores))
            return False
        if carpeta.exists():
            shutil.rmtree(carpeta)
        carpeta.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(borrador, carpeta)
    print("  ✓ %s/%s versión %s: %d casos (%d verificados), %d imágenes aquí y %d en Drive"
          % (segmento, tema_id, version, len(paquete["casos"]), sellados, aqui, len(en_drive)))
    return True


def quitar_retirados(publicados, solo_ver):
    """Borra de temas/ lo que el estudio ya no publica (solo lo que trajo este comando)."""
    cambios = False
    for marca in sorted((RAIZ / "temas").glob("*/*/" + MARCA)):
        carpeta = marca.parent
        if carpeta.name in publicados:
            continue
        print("  · %s/%s se quitaría de la web" % (carpeta.parent.name, carpeta.name)
              if solo_ver else "  ✗ %s/%s: quitado de la web" % (carpeta.parent.name, carpeta.name))
        if not solo_ver:
            import shutil
            shutil.rmtree(carpeta)
            if not any(carpeta.parent.iterdir()):
                carpeta.parent.rmdir()
        cambios = True
    return cambios


def main():
    parser = argparse.ArgumentParser(description="Trae los temas publicados en el estudio web.")
    parser.add_argument("--ver", action="store_true", help="no escribe nada; solo informa")
    args = parser.parse_args()

    try:
        claves = traer("publicacion.json?shallow=true") or {}
        verificaciones = traer("verificacion.json") or {}
    except Exception as e:  # sin red: el sitio se publica igual con lo que ya está en el repositorio
        print("No pude leer el estudio: %s" % e)
        return 0

    cambios = False
    print("Temas publicados en el estudio: %d" % len(claves))
    for clave in sorted(claves):
        if not ID.match(clave):
            continue
        publicacion = traer(f"publicacion/{clave}.json")
        if not publicacion or "paquete_json" not in publicacion:
            continue
        try:
            cambios = escribir_tema(clave, publicacion, verificaciones.get(clave), args.ver) or cambios
        except Exception as e:
            print("  ⚠ %s: %s" % (clave, e))
    cambios = quitar_retirados(set(claves), args.ver) or cambios
    if not cambios:
        print("Nada nuevo que traer.")
    salida = os.environ.get("GITHUB_OUTPUT")
    if salida:
        with open(salida, "a", encoding="utf-8") as f:
            f.write("cambios=%s\n" % ("true" if cambios else "false"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
