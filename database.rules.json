{
  "rules": {
    ".read": false,
    ".write": false,
    "indice_salas": {
      ".read": "auth != null",
      "$codigo": {
        ".write": "auth != null && ((!data.exists() && root.child('salas').child($codigo).child('info/host').val() == auth.uid) || (data.exists() && !newData.exists() && (root.child('salas').child($codigo).child('info/host').val() == auth.uid || data.val() < now - 86400000)))",
        ".validate": "newData.val() == now"
      }
    },
    "salas": {
      "$codigo": {
        ".write": "auth != null && ((!data.exists() && newData.child('info/host').val() == auth.uid && $codigo.matches(/^[A-Z]{4}$/)) || data.child('info/host').val() == auth.uid || (data.exists() && !newData.exists() && data.child('info/creada').val() < now - 86400000))",
        "info": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['host', 'creada', 'tema', 'titulo', 'casos', 'orden', 'duracion'])",
          "host": {
            ".validate": "newData.val() == auth.uid"
          },
          "creada": {
            ".validate": "newData.isNumber() && (newData.val() == data.val() || newData.val() == now)"
          },
          "tema": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]+\\/[a-z0-9-]+$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "duracion": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 180"
          },
          "casos": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            }
          },
          "temas": {
            "$i": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]+\\/[a-z0-9-]+$/)"
            }
          },
          "orden": {
            "$caso": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
              }
            }
          },
          "modo": {
            ".validate": "newData.isString() && newData.val().matches(/^(clasico|supervivencia|rescate)$/)"
          },
          "equipos": {
            ".validate": "newData.isString() && newData.val().matches(/^(anio|2|3|4)$/)"
          },
          "vidas": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
          },
          "rescates": {
            "$i": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
            }
          },
          "empezo": {
            ".validate": "newData.isNumber() && (newData.val() == data.val() || newData.val() == now)"
          },
          "$otro": {
            ".validate": false
          }
        },
        "estado": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['fase', 'indice'])",
          "fase": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|pregunta|revelar|ranking|fin)$/)"
          },
          "indice": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
          },
          "inicio": {
            ".validate": "newData.isNumber() && (newData.val() == data.val() || newData.val() == now)"
          },
          "rescate": {
            ".validate": "newData.isBoolean()"
          },
          "salvados": {
            ".validate": "newData.isBoolean()"
          },
          "$otro": {
            ".validate": false
          }
        },
        "jugadores": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('salas').child($codigo).child('info').exists()",
            ".validate": "newData.hasChildren(['nombre', 'unido'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "unido": {
              ".validate": "newData.isNumber() && (newData.val() == data.val() || newData.val() == now)"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,20}$/)"
            },
            "equipo": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,8}$/) && (newData.val() == data.val() || root.child('salas').child($codigo).child('estado/fase').val() == 'lobby')"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "respuestas": {
          ".read": "auth != null && root.child('salas').child($codigo).child('info/host').val() == auth.uid",
          "$indice": {
            ".read": "auth != null && (root.child('salas').child($codigo).child('estado/fase').val() != 'pregunta' || root.child('salas').child($codigo).child('estado/indice').val() + '' != $indice)",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('salas').child($codigo).child('jugadores').child($uid).exists() && (!root.child('salas').child($codigo).child('eliminados').child($uid).exists() || root.child('salas').child($codigo).child('estado/rescate').val() == true) && root.child('salas').child($codigo).child('estado/fase').val() == 'pregunta' && root.child('salas').child($codigo).child('estado/indice').val() + '' == $indice && now <= root.child('salas').child($codigo).child('estado/inicio').val() + root.child('salas').child($codigo).child('info/duracion').val() * 1000 + 3000",
              ".validate": "newData.hasChildren(['opcion', 't'])",
              "opcion": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
              },
              "t": {
                ".validate": "newData.val() == now"
              },
              "$otro": {
                ".validate": false
              }
            }
          }
        },
        "puntajes": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "eliminados": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
          }
        },
        "fallos": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          }
        },
        "stats": {
          ".read": "auth != null",
          "$uid": {
            "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "mr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "a": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "f": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "h": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "o": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "$otro": { ".validate": false }
          }
        },
        "premio": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.hasChildren(['i', 'pts'])",
            "i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
            "pts": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
            "racha": { ".validate": "newData.isBoolean()" },
            "solo": { ".validate": "newData.isBoolean()" },
            "$otro": { ".validate": false }
          }
        },
        "titulos": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{2,24}$/)"
          }
        },
        "tocados": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
          }
        },
        "rescatados": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200"
          }
        },
        "reacciones": {
          ".read": "auth != null && root.child('salas').child($codigo).child('info/host').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && newData.exists() && root.child('salas').child($codigo).child('jugadores').child($uid).exists() && (root.child('salas').child($codigo).child('estado/fase').val() == 'revelar' || root.child('salas').child($codigo).child('estado/fase').val() == 'ranking' || root.child('salas').child($codigo).child('estado/fase').val() == 'fin') && (!data.exists() || now >= data.child('t').val() + 1500)",
            ".validate": "newData.hasChildren(['e', 't'])",
            "e": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
            },
            "t": {
              ".validate": "newData.val() == now"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (auth != null && auth.uid == $uid && !data.exists() && newData.child('rol').val() == 'autor' && auth.token.firebase.sign_in_provider == 'google.com')",
        ".validate": "newData.hasChildren(['nombre', 'usuario', 'rol'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "usuario": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{2,30}$/)"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
        },
        "rol": {
          ".validate": "newData.isString() && newData.val().matches(/^(autor|revisor|coordinador)$/)"
        },
        "alta": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "solicitudes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "(auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com') || (auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador')",
        ".validate": "newData.hasChildren(['nombre', 'email', 'rol', 'fecha'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() == auth.token.email"
        },
        "rol": {
          ".validate": "newData.isString() && newData.val().matches(/^(autor|revisor)$/)"
        },
        "mensaje": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 500"
        },
        "fecha": {
          ".validate": "newData.val() == now"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "estudio": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() != null",
      "$tema": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (!data.exists() && newData.child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null) || (auth != null && data.child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && !newData.exists())",
        ".validate": "$tema.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.hasChild('meta')",
        "meta": {
          ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|publicado)$/) && newData.child('estado').val().matches(/^(borrador|publicado)$/)",
          ".validate": "newData.hasChildren(['titulo', 'segmento', 'autor_uid', 'autor_nombre', 'estado'])",
          "autor_uid": {
            ".validate": "newData.val() == data.val() || (!data.exists() && newData.val() == auth.uid) || (auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador')"
          },
          "estado": {
            ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|publicado)$/)",
            ".validate": "newData.isString() && newData.val().matches(/^(borrador|publicado)$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "segmento": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z-]+$/)"
          }
        },
        "fuente": {
          ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|publicado)$/)"
        },
        "imagenes": {
          ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|publicado)$/)"
        },
        "casos": {
          ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|publicado)$/)"
        },
        "comentarios": {
          "$caso": {
            "$c": {
              ".write": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() != null && !data.exists() && newData.child('uid').val() == auth.uid",
              ".validate": "newData.hasChildren(['uid', 'nombre', 'texto', 'fecha'])",
              "texto": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
              },
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
              },
              "fecha": {
                ".validate": "newData.val() == now"
              },
              "uid": {
                ".validate": "newData.isString()"
              },
              "$otro": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "estudio_img": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() != null",
      "$tema": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (auth != null && !newData.exists() && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid)",
        "$img": {
          ".write": "auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null && root.child('estudio').child($tema).child('meta/estado').val().matches(/^(borrador|cambios|publicado)$/)",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length < 400000"
        }
      }
    },
    "publicacion": {
      ".read": true,
      "$tema": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null)",
        ".validate": "newData.hasChildren(['paquete_json', 'fuentes_json', 'version', 'declaracion'])",
        "declaracion": {
          ".validate": "newData.hasChildren(['version', 'uid', 'fecha']) && newData.child('uid').val() == auth.uid && newData.child('fecha').val() == now"
        }
      }
    },
    "publicacion_img": {
      ".read": true,
      "$tema": {
        ".write": "auth != null && !newData.exists() && (root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador' || (root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null))"
      }
    },
    "indice_publicado": {
      ".read": true,
      "$tema": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null)",
        ".validate": "newData.hasChildren(['titulo', 'segmento'])",
        "titulo": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "segmento": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z-]+$/)"
        },
        "version": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "casos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "retirado": {
          ".validate": "newData.isBoolean()"
        },
        "oculto": {
          ".validate": "newData.isBoolean()"
        },
        "fecha": {
          ".validate": "newData.isNumber()"
        },
        "modalidades": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "actualizados": {
          "$caso": {
            ".validate": "newData.isNumber()"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "indice_casos": {
      ".read": true,
      "$tema": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador') || (auth != null && root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && root.child('usuarios').child(auth.uid).child('rol').val() != null)",
        ".validate": "newData.hasChildren(['version', 'casos'])",
        "version": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "casos": {
          "$caso": {
            ".validate": "$caso.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.hasChild('c')",
            "c": {
              "$i": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z-]+(\\/[a-z0-9-]+)?$/)"
              }
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "e": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              }
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "r": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "verificacion": {
      ".read": true,
      "$tema": {
        ".write": "auth != null && !newData.exists() && (root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador' || (root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && !root.child('publicacion').child($tema).exists()))",
        "$caso": {
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('rol').val() == 'revisor' || root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador')",
          ".validate": "newData.hasChildren(['decision', 'usuario', 'nombre', 'fecha'])",
          "decision": {
            ".validate": "newData.isString() && newData.val().matches(/^(verificado|problema)$/)"
          },
          "usuario": {
            ".validate": "newData.isString() && newData.val() == root.child('usuarios').child(auth.uid).child('usuario').val()"
          },
          "nombre": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "comentario": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1000"
          },
          "base": {
            ".validate": "newData.isNumber()"
          },
          "fecha": {
            ".validate": "newData.val() == now"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "reportes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() != null",
      "$tema": {
        ".write": "auth != null && !newData.exists() && (root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador' || (root.child('estudio').child($tema).child('meta/autor_uid').val() == auth.uid && !root.child('publicacion').child($tema).exists()))",
        "$caso": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() != null",
          "$uid": {
            ".write": "(auth != null && auth.uid == $uid && !data.exists()) || (auth != null && (root.child('usuarios').child(auth.uid).child('rol').val() == 'revisor' || root.child('usuarios').child(auth.uid).child('rol').val() == 'coordinador'))",
            ".validate": "newData.hasChildren(['texto', 'fecha'])",
            "texto": {
              ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 500"
            },
            "fecha": {
              ".validate": "newData.val() == now"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
